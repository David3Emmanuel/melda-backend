# --- database ----------------------------------------------------------------
# Leave DATABASE_URL unset to use the bundled in-process Postgres (PGlite): zero
# setup, no Docker, judges clone and run. Set it to point at a real Postgres:
# DATABASE_URL=postgres://user:pass@localhost:5432/melda
# Where PGlite persists its data (ignored when DATABASE_URL is set). Delete to reset.
PGLITE_DIR=.melda-pglite

# --- auth --------------------------------------------------------------------
JWT_SECRET=dev-only-change-me-in-production

# --- ai ----------------------------------------------------------------------
# A real Anthropic key turns on live drafting. Without it the backend serves the
# deterministic mock (same shapes, no network). The key stays server-side only.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- http --------------------------------------------------------------------
PORT=4000
# Comma-separated origins allowed by CORS (the two Expo apps in dev).
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
